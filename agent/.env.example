# ============================================================
# Jervis — Environment configuration (copy to .env and fill in)
# NEVER commit real tokens. This file is a template only.
# ============================================================

# --- Wake word & language ---
JERVIS_WAKE_WORD=hey jervis
JERVIS_LANGUAGE=auto            # auto | ur | en
JERVIS_MIC_INDEX=0              # 0 = default microphone
JERVIS_TTS_VOICE=default

# --- Dashboard bridge ---
JERVIS_WS_HOST=127.0.0.1
JERVIS_WS_PORT=8765

# --- Start with Windows ---
JERVIS_STARTUP=0                # 1 = enable startup

# --- GitHub (REQUIRED for GitHub features) ---
# Create a token: GitHub > Settings > Developer settings > Personal access tokens
# Scope: repo (for private repos) or public_repo
GITHUB_TOKEN=
GITHUB_USER=

# --- LinkedIn (optional, for publishing) ---
# LinkedIn OAuth2 access token (member permissions: w_member_social)
LINKEDIN_TOKEN=

# --- Optional local model endpoint (for richer generation) ---
# JERVIS_LLM_ENDPOINT=
# JERVIS_LLM_KEY=